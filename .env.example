ANTHROPIC_API_KEY=your-key-here

# Set to 1/true/yes to print one diagnostic line per spine sampling tick
# (chord_len, raw contour row count, the resulting hinge-point row index,
# and trunk_lean_2d) -- useful for comparing the actual numbers between
# postures (e.g. standing vs a deep squat) instead of guessing from the
# on-screen overlay. Off by default.
# SPINE_DEBUG=1

# How often (in seconds) the back-contour visualization re-samples via YOLO
# segmentation. Default 0.25 (4x/sec). Lower = updates faster but more CPU
# load per second (more lag); higher = less load, updates slower.
# SPINE_SAMPLE_INTERVAL_SECS=0.25

# How many dots to draw along the back contour. Default 10.
# SPINE_CONTOUR_POINT_COUNT=10

# Max ratio of shoulder_lateral_span to hip-shoulder torso length for the
# person to be considered "in profile" -- the back contour is only sampled
# below this. Scale-invariant (normalized by the person's own size in frame,
# not an absolute image distance), so it works the same regardless of how
# far the person stands from the camera. Default 0.4, an informed starting
# point -- not empirically validated.
# SPINE_MAX_SHOULDER_LATERAL_RATIO=0.4

# Fraction of the back-contour profile used by the ANGLE MEASUREMENT's vertex
# search (spine_thoracic_bend_2d / spine_lumbar_bend_2d), NOT the on-screen
# coloring (see SPINE_ZONE_DISPLAY_FRACTION below for that). Default 1/3
# (~0.333). WARNING: this is load-bearing for correctness, not just a display
# tweak -- raising it past ~0.35 has been measured to pull in a region where
# ordinary body-shape taper (not spine curvature) can flip a genuine bulge's
# sign entirely. See _SPINE_ZONE_FRACTION's docstring in
# qt/lib/core/spine_contour.py before changing this.
# SPINE_ZONE_FRACTION=0.3333333333333333

# Fraction of the 10 drawn/colored contour dots shown as thoracic/lumbar in
# the on-screen overlay -- purely cosmetic, has NO effect on the actual angle
# values. Safe to adjust freely. Default 0.4.
# SPINE_ZONE_DISPLAY_FRACTION=0.4

# Fraction of the way from the shoulder end (0.0) to the hip end (1.0) used
# as the shared "hinge" point between the thoracic and lumbar measurement
# triangles (a rough stand-in for the T12 thoracolumbar junction). Default
# 0.5 (the profile's midpoint) -- an informed starting point, not validated.
# SPINE_BEND_BOUNDARY_FRACTION=0.5

# Shifts the HIP end of the sampled shoulder-to-hip scan window upward (toward
# the shoulder) by this fraction of the shoulder-hip chord length. Without
# this, the window's bottom runs exactly at the hip joint, which
# over-includes the buttocks. Default 0.12, an informed starting point -- not
# empirically validated. This value is really "the reference shift once the
# person is meaningfully hip-hinged (e.g. partway into a squat)" -- it is NOT
# used as-is when standing upright. See SPINE_SCAN_SHIFT_FRAC_STANDING below.
# SPINE_SCAN_SHIFT_FRAC=0.12

# Window-shift fraction (same meaning as SPINE_SCAN_SHIFT_FRAC) used for the
# HIP end when the hip is essentially straight (standing tall). Standing tall
# (more lordosis) makes the glutes protrude further up along the back's
# silhouette than when hip-flexed, so a single fixed shift can't be correct
# in both postures -- the actual fraction used each tick is linearly
# interpolated between this and SPINE_SCAN_SHIFT_FRAC using the live
# hip-flexion angle, fully at this value at/below SPINE_SCAN_SHIFT_BEND_LOW_DEG
# and fully at SPINE_SCAN_SHIFT_FRAC at/above SPINE_SCAN_SHIFT_BEND_HIGH_DEG.
# Default 0.22, an informed starting point -- not empirically validated.
# SPINE_SCAN_SHIFT_FRAC_STANDING=0.22
# SPINE_SCAN_SHIFT_BEND_LOW_DEG=10.0
# SPINE_SCAN_SHIFT_BEND_HIGH_DEG=45.0

# Shifts the SHOULDER end of the scan window upward (toward the neck), by
# this fraction of the shoulder-hip chord length -- a separate, fixed
# fraction from the hip end's (SPINE_SCAN_SHIFT_FRAC*/_STANDING above): the
# shoulder end doesn't have the hip end's standing/bent buttock problem, so
# it doesn't need to track hip-flexion at all. The two ends used to share one
# fraction (a pure translation of the whole window), but once the hip end's
# fraction grew to accommodate standing posture (up to 0.22), applying that
# same larger fraction to the shoulder end pushed it visibly past the real
# shoulder into the neck. An ear-keypoint-based version of this shift was
# tried and reverted: even projected onto the hip-shoulder axis, the
# resulting anchor point could still land far up near/behind the head for a
# long neck or noisy ear reading. Default 0.12, an informed starting point --
# not empirically validated.
# SPINE_SHOULDER_SCAN_SHIFT_FRAC=0.12

# One-euro-filter tuning for the per-zone spine bend angle (thoracic/lumbar),
# smoothing the ~4Hz sampled degrees value over time. Separate from the
# per-frame keypoint-smoothing filters used elsewhere. Defaults: min_cutoff
# 1.0, beta 0.1, d_cutoff 1.0 -- informed starting points, not validated.
# SPINE_FILTER_MIN_CUTOFF=1.0
# SPINE_FILTER_BETA=0.1
# SPINE_FILTER_D_CUTOFF=1.0

# One-euro-filter tuning for the HIP and SHOULDER KEYPOINTS' PIXEL POSITION,
# applied before the spine scan window/crop is built from them -- so
# chord_len, the raw contour row count, and the drawn line's on-screen
# position are all consistently derived from these same smoothed points.
# Deliberately heavier (lower min_cutoff) than YOLOBackend's own per-frame
# keypoint smoothing (1.0): that alone wasn't enough to stop the chord's
# ends from visibly jittering a few pixels between ticks even during
# ordinary standing, which otherwise makes the whole drawn contour jitter up
# and down. Velocity-adaptive (OneEuroFilter: cutoff = min_cutoff +
# beta*speed), so genuine fast movement (e.g. standing up quickly out of a
# squat) is still tracked with much less lag once beta > 0 -- only near-
# stationary jitter is smoothed away. IMPORTANT: beta=0.0 disables that
# adaptation entirely (cutoff becomes constant regardless of speed) -- that
# was shipped as the default here by mistake and caused a ~0.5s-lag
# artifact (drawn line's bottom point sagging onto the buttock for a moment
# after standing up quickly, before catching up). Defaults: min_cutoff 0.3,
# beta 0.015, d_cutoff 1.0 -- informed starting points, not validated.
# SPINE_HIP_POSITION_MIN_CUTOFF=0.3
# SPINE_HIP_POSITION_BETA=0.015
# SPINE_HIP_POSITION_D_CUTOFF=1.0
# SPINE_SHOULDER_POSITION_MIN_CUTOFF=0.3
# SPINE_SHOULDER_POSITION_BETA=0.015
# SPINE_SHOULDER_POSITION_D_CUTOFF=1.0

# Same filter again, for the KNEE keypoint -- used only to compute the
# hip-flexion angle that drives SPINE_SCAN_SHIFT_FRAC_STANDING/
# SPINE_SCAN_SHIFT_FRAC's interpolation (SPINE_SCAN_SHIFT_FRAC_* above), not
# the crop/ROI geometry itself. Keep this equal to the hip/shoulder position
# filter values above -- the point is to give the hip-flexion angle the SAME
# lag as the hip/shoulder anchor position, so the scan-window shift fraction
# never disagrees with where the anchor geometry actually is. A mismatch
# here (e.g. using pose_frame's own, more lightly smoothed hip_bend_2d
# instead) was observed to contribute to the same buttock-sag artifact
# described above.
# SPINE_KNEE_POSITION_MIN_CUTOFF=0.3
# SPINE_KNEE_POSITION_BETA=0.015
# SPINE_KNEE_POSITION_D_CUTOFF=1.0
